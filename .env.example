# ─── V3 SDLC/ADLC Engine Configuration ───

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
SLACK_CHANNEL=#v3-builds

# Spec Directory
SPECS_ROOT=./specs
SPECS_SCAN_PATHS=./specs,../projects

# One-Shot Builder
MAX_BUILD_ITERATIONS=5
BUILD_TIMEOUT_MS=300000
PARALLEL_AGENTS=3

# Bug Scanner
STATIC_ANALYSIS_ENABLED=true
TEST_SUITE_COMMAND=npm test
LOG_PARSER_PATH=./logs

# AI Agent Configuration
AI_PROVIDER=openai
AI_MODEL=gpt-4o
AI_API_KEY=sk-xxx
AI_MAX_TOKENS=128000

# Notification Digest
DIGEST_MAX_BULLETS=3
DIGEST_COMPRESSION_RATIO=0.1

# API Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
